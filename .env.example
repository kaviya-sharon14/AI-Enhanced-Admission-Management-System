# ==============================================================================
# Admission Management System - Environment Configuration
# ==============================================================================

# Database Connection (MongoDB)
# Option 1: Local MongoDB instance
MONGO_URI=mongodb://localhost:27017/

# Option 2: MongoDB Atlas (Cloud Free Tier)
# Replace <username>, <password>, and cluster domain with your own Atlas credentials:
# MONGO_URI=mongodb+srv://dbUser:yourPassword@cluster0.mongodb.net/?retryWrites=true&w=majority

MONGO_DB_NAME=admissions_db

# Flask Application Secret Key
SECRET_KEY=institution-super-secure-key-2026-admission

# Server Port (Default: 5000)
PORT=5000

